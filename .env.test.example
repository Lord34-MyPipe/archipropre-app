# Copier en .env.test (jamais commité, voir .gitignore) et remplir les
# valeurs réelles. Procédure complète : docs/E2E_TESTS.md

# ── Supabase (mêmes valeurs que .env.local — MÊME projet, une résidence de
# test dédiée y est provisionnée automatiquement, jamais une résidence réelle) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# ── Compte manager de test EXISTANT (voir docs/CONTEXT.md) — jamais créé ni
# modifié par la suite, seulement utilisé pour se connecter. ──
E2E_MANAGER_EMAIL=manager@archipropre.fr
E2E_MANAGER_PASSWORD=Test1234!

# ── 2 comptes agent de test DÉDIÉS à la suite e2e (distincts de
# agent@archipropre.fr, qui reste désactivé en prod) — créés automatiquement
# au premier run si absents, marqués e2e_fixture=true en base (migration 034).
# IMPORTANT (incident du 21/07/2026, voir docs/CONTEXT.md) : choisissez un
# identifiant qui NE PEUT PAS correspondre à un employé réel — jamais un
# prénom ("christian", "marie"…), même approximatif. Un identifiant simple
# est résolu par l'app en <identifiant>@archipropre.local (voir
# lib/agent-identifiant.ts) : s'il collisionne avec un compte réel existant,
# le script refuse maintenant de le toucher (garde-fou e2e_fixture) plutôt
# que de le modifier silencieusement — mais autant choisir un identifiant
# sans ambiguïté dès le départ. E2E_AGENT_EMAIL se connecte dans les tests
# (agent principal) ; E2E_AGENT_BINOME_EMAIL n'est qu'un partenaire miroir,
# jamais loggé, pour exercer les chemins binôme. Choisissez un mot de passe ;
# le script de provisioning l'utilisera pour les deux. ──
E2E_AGENT_EMAIL=e2e-agent-principal
E2E_AGENT_BINOME_EMAIL=e2e-agent-binome
E2E_AGENT_PASSWORD=ChangeMe123!

# ── URL de l'app testée (serveur local démarré par Playwright — voir
# playwright.config.ts webServer). Ne pas pointer vers la prod. ──
PLAYWRIGHT_BASE_URL=http://localhost:3000
