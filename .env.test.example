# Copier en .env.test (jamais commité, voir .gitignore) et remplir les
# valeurs réelles. Procédure complète : docs/E2E_TESTS.md

# ── Supabase (mêmes valeurs que .env.local — MÊME projet, une résidence de
# test dédiée y est provisionnée automatiquement, jamais une résidence réelle) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# ── Compte manager de test EXISTANT (voir docs/CONTEXT.md) — jamais créé ni
# modifié par la suite, seulement utilisé pour se connecter. ──
E2E_MANAGER_EMAIL=manager@archipropre.fr
E2E_MANAGER_PASSWORD=Test1234!

# ── Compte agent de test DÉDIÉ à la suite e2e (distinct de agent@archipropre.fr,
# qui reste désactivé en prod) — créé automatiquement au premier run si absent.
# Choisissez un mot de passe ici ; le script de provisioning l'utilisera. ──
E2E_AGENT_EMAIL=agent-e2e@archipropre.fr
E2E_AGENT_PASSWORD=ChangeMe123!

# ── URL de l'app testée (serveur local démarré par Playwright — voir
# playwright.config.ts webServer). Ne pas pointer vers la prod. ──
PLAYWRIGHT_BASE_URL=http://localhost:3000
